#!/usr/bin/env bash
# setup — delegado de setup técnico do bootstrap (invariante 4 da skill bootstrap).
#
# Uso:
#   .rime/bin/setup <stack>          # imprime instruções de setup
#   .rime/bin/setup <stack> --run    # executa os passos
#   .rime/bin/setup --list           # lista stacks suportadas
#
# Stacks suportadas: node-ts, python-poetry, rust-cargo, go-modules.
# Adicionar nova stack: criar função setup_<stack> e adicionar ao SUPPORTED.

set -euo pipefail

SUPPORTED=("node-ts" "python-poetry" "rust-cargo" "go-modules")

usage() {
  cat <<EOF
.rime/bin/setup — delegado de setup técnico do bootstrap

Uso:
  .rime/bin/setup <stack>          imprime instruções de setup
  .rime/bin/setup <stack> --run    executa os passos
  .rime/bin/setup --list           lista stacks suportadas

Stacks: ${SUPPORTED[*]}
EOF
}

list_supported() {
  printf '%s\n' "${SUPPORTED[@]}"
}

is_supported() {
  local stack="$1"
  for s in "${SUPPORTED[@]}"; do
    [[ "$s" == "$stack" ]] && return 0
  done
  return 1
}

# Cada setup_<stack> imprime instruções na stdout; em modo --run, executa via run_step.
RUN_MODE=0
run_step() {
  local desc="$1"; shift
  if [[ $RUN_MODE -eq 1 ]]; then
    echo "→ $desc"
    "$@"
  else
    echo "  $ $* # $desc"
  fi
}

setup_node-ts() {
  echo "Setup node-ts:"
  run_step "inicializar package.json" npm init -y
  run_step "instalar typescript + tsx + vitest" npm i -D typescript tsx vitest @types/node
  run_step "gerar tsconfig.json" npx -y tsc --init --target es2022 --module nodenext --moduleResolution nodenext --strict --esModuleInterop --outDir dist
  run_step "criar package-lock.json" npm install
}

setup_python-poetry() {
  echo "Setup python-poetry:"
  run_step "inicializar pyproject.toml" poetry init --no-interaction
  run_step "instalar pytest" poetry add --group dev pytest
  run_step "gerar poetry.lock" poetry lock
  run_step "instalar deps" poetry install
}

setup_rust-cargo() {
  echo "Setup rust-cargo:"
  run_step "inicializar Cargo.toml" cargo init --name "$(basename "$PWD")"
  echo "  # cargo gera Cargo.lock automaticamente em build"
}

setup_go-modules() {
  echo "Setup go-modules:"
  run_step "inicializar go.mod" go mod init "$(basename "$PWD")"
  run_step "baixar deps (gera go.sum)" go mod tidy
}

# Despacho
[[ $# -eq 0 ]] && { usage; exit 0; }

case "$1" in
  --list) list_supported; exit 0 ;;
  -h|--help) usage; exit 0 ;;
esac

STACK="$1"
shift || true
[[ "${1:-}" == "--run" ]] && RUN_MODE=1

if ! is_supported "$STACK"; then
  echo "stack não suportada: $STACK" >&2
  echo "stacks disponíveis: ${SUPPORTED[*]}" >&2
  exit 2
fi

# Bash 3.2 não permite hífen direto em nome de função; mapeio para nome compatível.
case "$STACK" in
  node-ts)        setup_node-ts ;;
  python-poetry)  setup_python-poetry ;;
  rust-cargo)     setup_rust-cargo ;;
  go-modules)     setup_go-modules ;;
esac
